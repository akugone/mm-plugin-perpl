#!/usr/bin/env python3
"""`agent "<message>"` — one turn with the demo trading agent, printed for the camera.

Runs Claude Code headless in this folder (perpl-trading skill, CLAUDE.md, only `mm perpl` commands allowed, no MCP
servers) and continues the same conversation on every call. Prints what the agent says, every `mm perpl` command it
runs, and the first lines of what comes back. `agent --new` starts a fresh conversation.
"""
import json
import os
import subprocess
import sys
import re
import textwrap

HERE = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.join(HERE, ".session")
DIM, BOLD, CYAN, GREEN, RED, RESET = "\033[2m", "\033[1m", "\033[36m", "\033[32m", "\033[31m", "\033[0m"
WIDTH = int(os.environ.get("AGENT_WIDTH", "80"))


def plain(text):
    """Strip markdown emphasis so the terminal shows clean text."""
    return re.sub(r"(\*\*|__)(.+?)\1", r"\2", text).replace("**", "")


def main():
    args = sys.argv[1:]
    if args[:1] == ["--new"]:
        if os.path.exists(STATE):
            os.remove(STATE)
        args = args[1:]
        if not args:
            return
    prompt = " ".join(args)
    cmd = ["claude", "-p", prompt, "--output-format", "stream-json", "--verbose", "--model", os.environ.get("AGENT_MODEL", "opus"),
           "--settings", os.path.join(HERE, os.environ.get("AGENT_SETTINGS", "demo-settings.json")), "--strict-mcp-config", "--permission-mode", "default"]
    if os.path.exists(STATE):
        cmd += ["--resume", open(STATE).read().strip()]
    proc = subprocess.Popen(cmd, cwd=HERE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    first_text = True
    for raw in proc.stdout:
        try:
            ev = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if ev.get("type") == "system" and ev.get("session_id"):
            open(STATE, "w").write(ev["session_id"])
        if ev.get("type") == "assistant":
            for item in ev["message"].get("content", []):
                if item.get("type") == "text" and item["text"].strip():
                    for j, para in enumerate(plain(item["text"]).strip().split("\n")):
                        wrapped = textwrap.wrap(para, WIDTH - 2) or [""]
                        for k, line in enumerate(wrapped):
                            bullet = "● " if (first_text and j == 0 and k == 0) else "  "
                            print(f"{BOLD}{bullet}{RESET}{line}")
                    first_text = False
                    print()
                elif item.get("type") == "tool_use" and item.get("name") == "Bash":
                    print(f"  {CYAN}▸ {item['input'].get('command', '')}{RESET}")
                elif item.get("type") == "tool_use" and item.get("name") == "Skill":
                    print(f"  {DIM}▸ skill: {item['input'].get('skill', item['input'])}{RESET}")
        if ev.get("type") == "user":
            for item in ev["message"].get("content", []):
                if item.get("type") != "tool_result":
                    continue
                content = item.get("content")
                text = content if isinstance(content, str) else "\n".join(c.get("text", "") for c in content or [] if isinstance(c, dict))
                lines = [l for l in text.splitlines() if l.strip()]
                key = [l for l in lines if any(w in l for w in ("Error:", "Hint:", "status:", "fillPrice", "GUARD_BLOCKED", "CONFIRMATION_REQUIRED", '"code"', '"message"', '"hint"'))]
                show = (key or lines)[:3]
                color = RED if any(w in text for w in ("Error", "GUARD_BLOCKED", "CONFIRMATION_REQUIRED", '"ok": false')) else GREEN
                for l in show:
                    print(f"    {color}{DIM}{textwrap.shorten(l.strip(), WIDTH - 6, placeholder='…')}{RESET}")
                print()
    proc.wait()


if __name__ == "__main__":
    main()
